# Same-origin `/api/**` proxy target. Read at runtime by
# `app/api/[...path]/route.ts` on every request (no rebuild needed).
API_PROXY_TARGET=http://127.0.0.1:8100

# Server-only backend base used by SSR fetches (site settings, content).
API_INTERNAL_BASE=http://127.0.0.1:8100

# Optional public origin for canonical URLs / robots in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3200
